# ─── App ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# VITE_PORT=8173
# CLIENT_VITE_DEV_SERVER_URL=http://localhost:8173
CLIENT_URL=http://localhost:5173

# ─── Database ────────────────────────────────────────────
# Local PostgreSQL connection string example
DATABASE_URL="postgresql://postgres:1234@localhost:5432/task_management?schema=public"

# ─── JWT ────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# ─── Bcrypt ──────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ─── Email (SMTP) ────────────────────────────────────────
# Use Mailtrap (https://mailtrap.io) for development — paste credentials below.
# For Gmail: host=smtp.gmail.com port=587 secure=false (use an App Password)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_smtp_user
EMAIL_PASS=your_smtp_password
EMAIL_FROM="Task Manager <noreply@taskmanager.local>"
# Password-reset token lifetime in milliseconds (default: 3600000 = 1 hour)
RESET_TOKEN_TTL_MS=3600000
